{
    "census": {
        "url": "https://api.census.gov/data/{year}/acs/acs5",
        "params": {
            "get": "NAME,B01001_001E,B01002_001E",
            "for": "county:{county}",
            "in": "state:{state}"
        },
        "columns": {
            "B01001_001E": "total_population",
            "B01002_001E": "median_age"
        }
    },
    "bls": {
        "url": "https://api.bls.gov/publicAPI/v2/timeseries/data/",
        "params": {
            "registrationkey": "your_api_key_here"
        },
        "series_template": "LAUCN{fips}{data_type}"
    },
    "zillow": {
        "direct_download": "https://files.zillowstatic.com/research/public_csvs/zhvi/County_zhvi_uc_sfrcondo_tier_0.33_0.67_sm_sa_month.csv"
    },
    "noaa": {
        "url": "https://www.ncdc.noaa.gov/cdo-web/api/v2/data",
        "params": {
            "datasetid": "GHCND",
            "locationid": "FIPS:{fips}",
            "startdate": "YYYY-MM-DD",
            "enddate": "YYYY-MM-DD",
            "limit": 1000
        },
        "headers": {
            "token": "your_noaa_token_here"
        }
    },
    "fred": {
        "url": "https://api.stlouisfed.org/fred/series/observations",
        "params": {
            "api_key": "your_fred_api_key_here",
            "file_type": "json"
        }
    }
}